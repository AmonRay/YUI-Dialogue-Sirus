<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
    <Script file="SharedUITemplates.lua"/>
    <Script file="GenericFrame.lua"/>

    <Frame name="DUIGenericTitledFrameTemplate" setAllPoints="true" useParentLevel="true" virtual="true">
        <Frames>
            <!-- Nine ordinary textures are created by the mixin for 3.3.5. -->
            <Frame parentKey="Background" setAllPoints="true"/>
        </Frames>
        <Scripts>
            <OnLoad>DUI_ApplyMixin(self, "DUIGenericTitledFrameMixin"); self:OnLoad();</OnLoad>
        </Scripts>
    </Frame>
</Ui>